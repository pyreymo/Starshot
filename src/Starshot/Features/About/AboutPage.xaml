<?xml version="1.0" encoding="utf-8" ?>
<sf:PageBase
  x:Class="Starshot.Features.About.AboutPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:lang="using:Starshot.Language"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:sf="using:Starshot.Frameworks"
  mc:Ignorable="d"
>
  <ScrollViewer Padding="0">
    <StackPanel MaxWidth="720" Padding="48,24,48,48" Spacing="20">
      <Grid Margin="0,0,0,0">
        <StackPanel VerticalAlignment="Center" Margin="0,10,0,0" Spacing="2">
          <TextBlock FontSize="32" FontWeight="Bold" Text="{x:Bind lang:Lang.Starshot_Nav_About}" />
          <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}">
            <Run Text="Copyright © 2026 " />
            <Hyperlink NavigateUri="https://gravatar.com/loliri1124" UnderlineStyle="None">
              <Run
                FontWeight="SemiBold"
                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                Text="loliri"
              />
            </Hyperlink>
            <Run Text=" · " />
            <Run Text="{x:Bind lang:Lang.Starshot_AboutLicense}" />
          </TextBlock>
        </StackPanel>
        <!--  logo 可点：常态全透明（无背景无边框），悬停出主题填充 + 按压反馈；点 5 次开启开发者模式（只开不关）  -->
        <Button
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          Padding="8"
          Background="Transparent"
          BorderThickness="0"
          Click="Button_Logo_Click"
          CornerRadius="8"
        >
          <Image Height="80" Source="ms-appx:///Assets/logo.png" />
        </Button>
      </Grid>

      <Border
        Padding="24"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8"
      >
        <StackPanel Spacing="6">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Starshot" />
            <Border
              Padding="8,2,8,2"
              VerticalAlignment="Center"
              Background="{ThemeResource AccentFillColorDefaultBrush}"
              CornerRadius="4"
            >
              <TextBlock
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextOnAccentFillColorDefaultBrush}"
                Text="{x:Bind Version}"
              />
            </Border>
          </StackPanel>
          <TextBlock
            Margin="0,4,0,0"
            FontWeight="SemiBold"
            Text="{x:Bind lang:Lang.Starshot_AboutTagline}"
          />
          <TextBlock
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind lang:Lang.Starshot_AboutDesc}"
            TextWrapping="Wrap"
          />
          <Grid Margin="0,8,0,0" ColumnSpacing="6" RowSpacing="4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
              FontSize="13"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              Text="{x:Bind lang:Lang.Starshot_AboutProjectHome}"
            />
            <TextBlock Grid.Column="1" FontSize="13">
              <Hyperlink x:Name="WebSiteLink" UnderlineStyle="None">
                <Run x:Name="WebSiteUrlText" />
              </Hyperlink>
            </TextBlock>
            <TextBlock
              Grid.Row="1"
              FontSize="13"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              Text="{x:Bind lang:Lang.Starshot_AboutProjectRepo}"
            />
            <TextBlock Grid.Row="1" Grid.Column="1" FontSize="13">
              <Hyperlink x:Name="RepoLink" UnderlineStyle="None">
                <Run x:Name="RepoUrlText" />
              </Hyperlink>
            </TextBlock>
            <TextBlock
              Grid.Row="2"
              FontSize="13"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              Text="{x:Bind lang:Lang.Starshot_AboutThanksTitle}"
            />
            <TextBlock Grid.Row="2" Grid.Column="1" FontSize="13" TextWrapping="Wrap">
              <Hyperlink NavigateUri="https://github.com/Scighost/Starward" UnderlineStyle="None">
                <Run Text="Starward" />
              </Hyperlink>
              <Run Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text=" · " />
              <Hyperlink NavigateUri="https://github.com/ShareX/ShareX" UnderlineStyle="None">
                <Run Text="ShareX" />
              </Hyperlink>
              <Run Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text=" · " />
              <Hyperlink
                NavigateUri="https://github.com/YuehaiTeam/kachina-installer"
                UnderlineStyle="None"
              >
                <Run Text="kachina-installer" />
              </Hyperlink>
            </TextBlock>
            <TextBlock
              Grid.Row="3"
              FontSize="13"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              Text="{x:Bind lang:Lang.Starshot_AboutPrivacyTitle}"
            />
            <TextBlock
              Grid.Row="3"
              Grid.Column="1"
              FontSize="12"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              Text="{x:Bind lang:Lang.Starshot_AboutPrivacy}"
              TextWrapping="Wrap"
            />
          </Grid>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</sf:PageBase>
